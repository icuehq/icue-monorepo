{
    "hosting": {
        "public": "build/web",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "**/!(*.@(js|mjs|css|png|jpg|jpeg|gif|webp|svg|woff|woff2|ttf|otf|json|wasm|part|map))",
                "destination": "/index.html"
            }
        ],
        "headers": [
            {
                "source": "**",
                "headers": [
                    {
                        "key": "Cross-Origin-Opener-Policy",
                        "value": "same-origin-allow-popups"
                    }
                ]
            },
            {
                "source": "**/*.@(js|css|wasm|mjs)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "@(index.html|flutter_bootstrap.js|flutter_service_worker.js|version.json|main.dart.js|main.dart.wasm)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            }
        ]
    },
    "flutter": {
        "platforms": {
            "android": {
                "default": {
                    "projectId": "icueadmin",
                    "appId": "1:682367186948:android:c3bdd27bd6139861b81d51",
                    "fileOutput": "android/app/src/prod/google-services.json"
                }
            },
            "ios": {
                "default": {
                    "projectId": "icueadmin",
                    "appId": "1:682367186948:ios:5eac0ded1e1b29cab81d51",
                    "uploadDebugSymbols": false,
                    "fileOutput": "ios/config/prod/GoogleService-Info.plist"
                }
            },
            "dart": {
                "lib/firebase_options_prod.dart": {
                    "projectId": "icueadmin",
                    "configurations": {
                        "android": "1:682367186948:android:c3bdd27bd6139861b81d51",
                        "ios": "1:682367186948:ios:5eac0ded1e1b29cab81d51",
                        "web": "1:682367186948:web:6180308950468321b81d51"
                    }
                }
            }
        }
    }
}