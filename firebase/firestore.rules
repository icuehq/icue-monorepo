rules_version = '2';

// Clients read; all writes go through Cloud Functions (Admin SDK bypasses rules).
// Exceptions: own device tokens/mute, and verification count lines (offline counting, Inv-8).
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function inSchool(sid) { return signedIn() && string(request.auth.token.sid) == sid; }
    function access(sid) { return get(/databases/$(db)/documents/schools/$(sid)/userAccess/$(request.auth.uid)).data; }
    function can(sid, p) { return p in access(sid).perms; }
    function onCampus(sid, c) { return access(sid).all == true || c in access(sid).cmp; }
    function own() {
      return resource.data.personErpId == request.auth.token.get('eid', null)
          || resource.data.personErpId in request.auth.token.get('wards', []);
    }

    // Default: no client writes anywhere under a school. Reads need an explicit rule below.
    // auditLogs, requests, uniqueKeys, outbox, counters have no client access at all.
    match /schools/{sid}/{coll}/{id} {
      allow write: if false;
    }

    match /schools/{sid}/userAccess/{uid} {
      allow read: if inSchool(sid) && request.auth.uid == uid;
    }
    match /schools/{sid}/config/{doc} {
      allow read: if inSchool(sid);
    }
    match /schools/{sid}/notifications/{id} {
      allow read: if inSchool(sid) && resource.data.uid == request.auth.uid;
    }

    // Inventory masters (Inv-1).
    match /schools/{sid}/{coll}/{id} {
      allow read: if inSchool(sid) && coll in ['invCategories', 'invUnits', 'invItems']
        && (can(sid, 'inv.items.view') || can(sid, 'inv.issue.request') || can(sid, 'inv.pr.request'));
    }
    match /schools/{sid}/invItems/{itemId}/variants/{id} {
      allow read: if inSchool(sid) && (can(sid, 'inv.items.view') || can(sid, 'inv.issue.request') || can(sid, 'inv.pr.request'));
    }
    // Stores are readable school-wide so a transfer can name a destination on another campus.
    match /schools/{sid}/invStores/{id} {
      allow read: if inSchool(sid)
        && (can(sid, 'inv.stock.view') || can(sid, 'inv.settings') || can(sid, 'inv.issue.request'));
    }

    // Stock (Inv-2): campus-scoped, written only by Functions.
    match /schools/{sid}/{coll}/{id} {
      allow read: if inSchool(sid)
        && coll in ['invBalances', 'invMovements', 'invReceipts', 'invIssues', 'invReturns', 'invAdjustments', 'invUnavailable']
        && can(sid, 'inv.stock.view') && onCampus(sid, resource.data.campusId);
    }
    // Requesters see their own requests; approvers and stock users see the campus's.
    match /schools/{sid}/invIssueRequests/{id} {
      allow read: if inSchool(sid) && (resource.data.createdBy == request.auth.uid
        || ((can(sid, 'inv.stock.view') || can(sid, 'inv.issue.approve')) && onCampus(sid, resource.data.campusId)));
    }
    // Either end of a transfer may read it.
    match /schools/{sid}/invTransfers/{id} {
      allow read: if inSchool(sid) && can(sid, 'inv.stock.view')
        && (onCampus(sid, resource.data.campusId) || onCampus(sid, resource.data.toCampusId));
    }

    // Procurement (Inv-3). Vendors are school-wide; requesters see their own requests,
    // approvers and procurement the campus's.
    match /schools/{sid}/invVendors/{id} {
      allow read: if inSchool(sid) && (can(sid, 'inv.vendors.manage') || can(sid, 'inv.procure.operate'));
    }
    match /schools/{sid}/invPurchaseRequests/{id} {
      allow read: if inSchool(sid) && (resource.data.createdBy == request.auth.uid
        || ((can(sid, 'inv.pr.approve') || can(sid, 'inv.procure.operate')) && onCampus(sid, resource.data.campusId)));
    }

    // Quotations and purchase orders (Inv-4): procurement on the campus.
    match /schools/{sid}/invQuotations/{id} {
      allow read: if inSchool(sid) && can(sid, 'inv.procure.operate') && onCampus(sid, resource.data.campusId);
    }
    // Receiving staff read orders due at their campus; invoices (Inv-5) follow procurement.
    match /schools/{sid}/invPurchaseOrders/{id} {
      allow read: if inSchool(sid) && ((can(sid, 'inv.procure.operate')
        && (onCampus(sid, resource.data.campusId) || onCampus(sid, resource.data.deliveryCampusId)))
        || (can(sid, 'inv.stock.operate') && onCampus(sid, resource.data.deliveryCampusId)));
    }
    match /schools/{sid}/invInvoices/{id} {
      allow read: if inSchool(sid) && can(sid, 'inv.procure.operate') && onCampus(sid, resource.data.campusId);
    }
    match /schools/{sid}/invPurchaseOrders/{id}/revisions/{rev} {
      allow read: if inSchool(sid) && can(sid, 'inv.procure.operate');
    }

    // Assets and maintenance (Inv-6). Assignees also read their own custody records.
    match /schools/{sid}/{coll}/{id} {
      allow read: if inSchool(sid) && coll in ['invAssets', 'invMaintenance']
        && can(sid, 'inv.assets.view') && onCampus(sid, resource.data.campusId);
    }
    match /schools/{sid}/invAssets/{id}/history/{h} {
      allow read: if inSchool(sid) && can(sid, 'inv.assets.view') && onCampus(sid, resource.data.campusId);
    }
    match /schools/{sid}/invAssetAssignments/{id} {
      allow read: if inSchool(sid) && ((can(sid, 'inv.assets.view') && onCampus(sid, resource.data.campusId)) || own());
    }

    // Verification sessions (Inv-7): stock users on the campus; counting is also a direct line update so it queues offline.
    match /schools/{sid}/invVerifications/{id} {
      allow read: if inSchool(sid) && can(sid, 'inv.stock.view') && onCampus(sid, resource.data.campusId);
    }
    match /schools/{sid}/invVerifications/{id}/lines/{l} {
      allow read: if inSchool(sid) && can(sid, 'inv.stock.view') && onCampus(sid, resource.data.campusId);
      // Count only: the same fields `inv-verification-count` writes, while the session is still `counting`.
      allow update: if inSchool(sid) && can(sid, 'inv.stock.operate') && onCampus(sid, resource.data.campusId)
        && get(/databases/$(db)/documents/schools/$(sid)/invVerifications/$(id)).data.status == 'counting'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counted', 'diff', 'reason', 'note', 'countedBy', 'countedAt'])
        && request.resource.data.counted is number && request.resource.data.counted >= 0
        && request.resource.data['diff'] == request.resource.data.counted - resource.data.expected
        && request.resource.data.countedBy == request.auth.uid
        && (request.resource.data.reason == null
            || request.resource.data.reason in ['count_correction', 'missing', 'excess', 'other']);
    }

    // Reports and the dashboard (Inv-7): report viewers read the campus's records in every report collection.
    match /schools/{sid}/{coll}/{id} {
      allow read: if inSchool(sid) && can(sid, 'inv.reports.view') && onCampus(sid, resource.data.campusId)
        && coll in ['invBalances', 'invMovements', 'invReceipts', 'invIssues', 'invReturns', 'invAdjustments', 'invUnavailable',
          'invIssueRequests', 'invTransfers', 'invPurchaseRequests', 'invQuotations', 'invPurchaseOrders', 'invInvoices',
          'invAssets', 'invAssetAssignments', 'invMaintenance', 'invVerifications'];
    }
    match /schools/{sid}/invVendors/{id} {
      allow read: if inSchool(sid) && can(sid, 'inv.reports.view');
    }

    // Library masters (Lib-1): catalogue is school-wide, readable by anyone who may browse it.
    match /schools/{sid}/{coll}/{id} {
      allow read: if inSchool(sid) && coll in ['libLibraries', 'libCategories', 'libCatalogue', 'libCopies']
        && can(sid, 'lib.catalogue.view');
    }
    // Acquisition records (Lib-2): librarians only.
    match /schools/{sid}/libAcquisitions/{id} {
      allow read: if inSchool(sid) && can(sid, 'lib.catalogue.manage');
    }
    // Members and borrowing policies (Lib-3).
    match /schools/{sid}/{coll}/{id} {
      allow read: if inSchool(sid) && coll in ['libMembers', 'libPolicies'] && can(sid, 'lib.members.view');
    }

    // Loans (Lib-4): circulation staff on the campus, or the borrower / parent by ERP ID.
    match /schools/{sid}/libLoans/{id} {
      allow read: if inSchool(sid) && ((can(sid, 'lib.circulation.operate') && onCampus(sid, resource.data.campusId)) || own());
    }

    match /devices/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['mute']);

      match /tokens/{id} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['token', 'platform', 'app', 'updatedAt'])
          && request.resource.data.token is string;
      }
    }
  }
}
