rules_version = '2';

// Clients read; all writes go through Cloud Functions (Admin SDK bypasses rules).
// Exceptions: own device tokens/mute, Receive Stock (receipts, ledger rows, balances), issue request submit/approve, the master collections, and purchase requests/quotations/invoices.
// Inventory and Library business records carry a `lastWrite` stamp (see stamped()); code-keyed masters do not.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    // The branch is the tenant: the token is issued for one active branch (a zone or corporate user re-exchanges to switch) and its claims must match the path.
    function inBranch(orgId, zoneId, branchId) {
      return signedIn() && string(request.auth.token.orgId) == orgId
        && string(request.auth.token.zoneId) == zoneId && string(request.auth.token.branchId) == branchId;
    }
    function access(orgId, zoneId, branchId) { return get(/databases/$(db)/documents/orgs/$(orgId)/zones/$(zoneId)/branches/$(branchId)/userAccess/$(request.auth.uid)).data; }
    // Library has no sub-permissions: the Node tile gates the UI and any non-parent staff user of the branch may operate.
    function staff(orgId, zoneId, branchId) { return inBranch(orgId, zoneId, branchId) && request.auth.token.get('personType', '') != 'parent'; }
    function can(orgId, zoneId, branchId, p) { return p in access(orgId, zoneId, branchId).permissions; }
    function topLevelCategory(data) { return !('parentId' in data) || data.parentId == null; }
    function own() {
      return resource.data.personErpId == request.auth.token.get('personErpId', null)
          || resource.data.personErpId in request.auth.token.get('wardStudentIds', []);
    }

    // Default: no client writes anywhere under a branch. Reads need an explicit rule below.
    // auditLogs, requests and outbox have no client access at all (uniqueKeys: only Library title keys, below).
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/{coll}/{id} {
      allow write: if false;
    }

    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/userAccess/{uid} {
      allow read: if inBranch(orgId, zoneId, branchId) && request.auth.uid == uid;
    }
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/config/{doc} {
      allow read: if inBranch(orgId, zoneId, branchId);
    }
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/notifications/{id} {
      allow read: if inBranch(orgId, zoneId, branchId) && resource.data.uid == request.auth.uid;
    }

    // Inventory masters (Inv-1).
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/{coll}/{id} {
      allow read: if inBranch(orgId, zoneId, branchId) && coll in ['inventoryCategories', 'inventoryUnits', 'inventoryItems']
        && (can(orgId, zoneId, branchId, 'inventory.items.view') || can(orgId, zoneId, branchId, 'inventory.issue.request') || can(orgId, zoneId, branchId, 'inventory.purchaseRequest.request'));
    }
    // Masters are plain client CRUD for the users who manage them (no field validation, no audit log).
    // Creates are keyed by the lowercased code, so an existing code cannot be recreated.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryCategories/{id} {
      allow write: if inBranch(orgId, zoneId, branchId) && can(orgId, zoneId, branchId, 'inventory.settings');
    }
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryUnits/{id} {
      allow write: if inBranch(orgId, zoneId, branchId) && can(orgId, zoneId, branchId, 'inventory.settings');
    }
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryStores/{id} {
      allow write: if inBranch(orgId, zoneId, branchId) && can(orgId, zoneId, branchId, 'inventory.settings');
    }
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryItems/{id} {
      allow write: if inBranch(orgId, zoneId, branchId) && can(orgId, zoneId, branchId, 'inventory.items.manage');
    }
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryVendors/{id} {
      allow write: if inBranch(orgId, zoneId, branchId) && can(orgId, zoneId, branchId, 'inventory.vendors.manage');
    }
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/libraries/{id} {
      allow write: if staff(orgId, zoneId, branchId);
    }
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/libraryCategories/{id} {
      // Two levels only: a subcategory's parent must itself be a top-level category.
      allow write: if staff(orgId, zoneId, branchId)
        && (request.method == 'delete' || topLevelCategory(request.resource.data)
          || topLevelCategory(get(/databases/$(db)/documents/orgs/$(orgId)/zones/$(zoneId)/branches/$(branchId)/libraryCategories/$(request.resource.data.parentId)).data));
    }

    // Purchase requests, quotations and invoices: client writes for the roles that handle them.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryPurchaseRequests/{id} {
      allow write: if inBranch(orgId, zoneId, branchId) && stamped()
        && (can(orgId, zoneId, branchId, 'inventory.purchaseRequest.request') || can(orgId, zoneId, branchId, 'inventory.purchaseRequest.approve'));
      // Issuing, cancelling or closing a purchase order moves its quantity on the request.
      allow update: if inBranch(orgId, zoneId, branchId) && stamped() && can(orgId, zoneId, branchId, 'inventory.procure.operate');
      // The last fully received order completes its request.
      allow update: if inBranch(orgId, zoneId, branchId) && stamped() && can(orgId, zoneId, branchId, 'inventory.stock.operate')
        && request.resource.data.status == 'completed';
    }
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryQuotations/{id} {
      allow write: if inBranch(orgId, zoneId, branchId) && stamped() && can(orgId, zoneId, branchId, 'inventory.procure.operate');
    }
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryInvoices/{id} {
      allow write: if inBranch(orgId, zoneId, branchId) && stamped() && can(orgId, zoneId, branchId, 'inventory.procure.operate');
    }
    // Purchase orders: client writes until cancelled or closed; receiving stays a callable.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryPurchaseOrders/{id} {
      allow create: if inBranch(orgId, zoneId, branchId) && stamped() && can(orgId, zoneId, branchId, 'inventory.procure.operate')
        && request.resource.data.status == 'draft';
      allow update: if inBranch(orgId, zoneId, branchId) && stamped() && can(orgId, zoneId, branchId, 'inventory.procure.operate')
        && !(resource.data.status in ['cancelled', 'closed']);
      // Receiving goods moves an order to (partially / fully) received.
      allow update: if inBranch(orgId, zoneId, branchId) && stamped() && can(orgId, zoneId, branchId, 'inventory.stock.operate')
        && request.resource.data.status in ['partially_received', 'fully_received'];
    }
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryPurchaseOrders/{id}/revisions/{rev} {
      allow create: if inBranch(orgId, zoneId, branchId) && can(orgId, zoneId, branchId, 'inventory.procure.operate');
    }
    // Sequence counters (PR/QT/PO numbers) are bumped by clients that hold any permission (parents hold none).
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/counters/{id} {
      allow read, write: if inBranch(orgId, zoneId, branchId) && access(orgId, zoneId, branchId).permissions.size() > 0;
    }

    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryItems/{itemId}/variants/{id} {
      allow write: if inBranch(orgId, zoneId, branchId) && can(orgId, zoneId, branchId, 'inventory.items.manage');
      allow read: if inBranch(orgId, zoneId, branchId) && (can(orgId, zoneId, branchId, 'inventory.items.view') || can(orgId, zoneId, branchId, 'inventory.issue.request') || can(orgId, zoneId, branchId, 'inventory.purchaseRequest.request'));
    }
    // Stores are readable branch-wide.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryStores/{id} {
      allow read: if inBranch(orgId, zoneId, branchId)
        && (can(orgId, zoneId, branchId, 'inventory.stock.view') || can(orgId, zoneId, branchId, 'inventory.settings') || can(orgId, zoneId, branchId, 'inventory.issue.request'));
    }

    // Stock (Inv-2): written only by Functions.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/{coll}/{id} {
      allow read: if inBranch(orgId, zoneId, branchId)
        && coll in ['inventoryBalances', 'inventoryMovements', 'inventoryReceipts', 'inventoryIssues', 'inventoryReturns', 'inventoryAdjustments', 'inventoryUnavailableStock']
        && can(orgId, zoneId, branchId, 'inventory.stock.view');
    }
    // Receive Stock, issuing stock and returns are client transactions: stock operators create receipts, issues, returns, unavailable-stock
    // entries and ledger rows (never edit them) and create/update the store's balances.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/{coll}/{id} {
      allow create: if inBranch(orgId, zoneId, branchId) && coll in ['inventoryReceipts', 'inventoryIssues', 'inventoryReturns', 'inventoryAdjustments', 'inventoryUnavailableStock', 'inventoryMovements']
        && can(orgId, zoneId, branchId, 'inventory.stock.operate')
        && (coll == 'inventoryMovements' || stamped())
        && request.resource.data.createdBy == request.auth.uid;
    }
    // A return only moves an issue's returned quantities.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryIssues/{id} {
      allow update: if inBranch(orgId, zoneId, branchId) && stamped() && can(orgId, zoneId, branchId, 'inventory.stock.operate')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lineItems', 'lastWrite', 'updatedAt']);
    }
    // Acknowledging an issue only fills its empty acknowledgement.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryIssues/{id} {
      allow update: if inBranch(orgId, zoneId, branchId) && stamped() && can(orgId, zoneId, branchId, 'inventory.stock.operate')
        && resource.data.acknowledgement == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledgement', 'lastWrite', 'updatedAt'])
        && request.resource.data.acknowledgement.performedBy == request.auth.uid;
    }
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryBalances/{id} {
      allow create, update: if inBranch(orgId, zoneId, branchId) && can(orgId, zoneId, branchId, 'inventory.stock.operate')
       ;
    }
    // Submitting, approving/rejecting and issuing against an issue request, and acknowledging an issue, are client writes.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryIssueRequests/{id} {
      allow create: if inBranch(orgId, zoneId, branchId) && stamped() && can(orgId, zoneId, branchId, 'inventory.issue.request')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending';
      // Approve / reject: only while pending, by an approver, touching only the decision fields.
      allow update: if inBranch(orgId, zoneId, branchId) && stamped() && can(orgId, zoneId, branchId, 'inventory.issue.approve')
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lineItems', 'approval', 'lastWrite', 'updatedAt'])
        && request.resource.data.approval.performedBy == request.auth.uid;
    }
    // Issuing stock only moves an approved request's issued quantities and status.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryIssueRequests/{id} {
      allow update: if inBranch(orgId, zoneId, branchId) && stamped() && can(orgId, zoneId, branchId, 'inventory.stock.operate')
        && resource.data.status in ['approved', 'partially_issued']
        && request.resource.data.status in ['partially_issued', 'issued']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lineItems', 'lastWrite', 'updatedAt']);
    }
    // The requester may withdraw a pending request; a stock operator may close one still awaiting issue.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryIssueRequests/{id} {
      allow update: if inBranch(orgId, zoneId, branchId) && stamped()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closure', 'lastWrite', 'updatedAt'])
        && request.resource.data.closure.performedBy == request.auth.uid
        && ((resource.data.createdBy == request.auth.uid && resource.data.status == 'pending' && request.resource.data.status == 'cancelled')
          || (can(orgId, zoneId, branchId, 'inventory.stock.operate')
            && resource.data.status in ['approved', 'partially_issued'] && request.resource.data.status == 'closed'));
    }
    // Requesters see their own requests; approvers and stock users see all of them.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryIssueRequests/{id} {
      allow read: if inBranch(orgId, zoneId, branchId) && (resource.data.createdBy == request.auth.uid
        || ((can(orgId, zoneId, branchId, 'inventory.stock.view') || can(orgId, zoneId, branchId, 'inventory.issue.approve'))));
    }
    // Resolving an unavailable-stock entry: restore, repair or write off, by a stock operator.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryUnavailableStock/{id} {
      allow update: if inBranch(orgId, zoneId, branchId) && stamped() && can(orgId, zoneId, branchId, 'inventory.stock.operate')
        && resource.data.status in ['open', 'in_repair']
        && request.resource.data.status in ['in_repair', 'resolved']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolution', 'resolutionNote', 'resolvedAt', 'resolvedBy', 'lastWrite', 'updatedAt']);
    }

    // Procurement (Inv-3). Vendors are branch-wide; requesters see their own requests,
    // approvers and procurement all of them.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryVendors/{id} {
      allow read: if inBranch(orgId, zoneId, branchId) && (can(orgId, zoneId, branchId, 'inventory.vendors.manage') || can(orgId, zoneId, branchId, 'inventory.procure.operate'));
    }
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryPurchaseRequests/{id} {
      allow read: if inBranch(orgId, zoneId, branchId) && (resource.data.createdBy == request.auth.uid
        || ((can(orgId, zoneId, branchId, 'inventory.purchaseRequest.approve') || can(orgId, zoneId, branchId, 'inventory.procure.operate'))));
    }

    // Quotations and purchase orders (Inv-4): procurement.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryQuotations/{id} {
      allow read: if inBranch(orgId, zoneId, branchId) && can(orgId, zoneId, branchId, 'inventory.procure.operate');
    }
    // Receiving staff read orders due ; invoices (Inv-5) follow procurement.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryPurchaseOrders/{id} {
      allow read: if inBranch(orgId, zoneId, branchId) && (can(orgId, zoneId, branchId, 'inventory.procure.operate') || can(orgId, zoneId, branchId, 'inventory.stock.operate'));
    }
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryInvoices/{id} {
      allow read: if inBranch(orgId, zoneId, branchId) && can(orgId, zoneId, branchId, 'inventory.procure.operate');
    }
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryPurchaseOrders/{id}/revisions/{rev} {
      allow read: if inBranch(orgId, zoneId, branchId) && can(orgId, zoneId, branchId, 'inventory.procure.operate');
    }

    // Assets and maintenance (Inv-6). Assignees also read their own custody records.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/{coll}/{id} {
      allow read: if inBranch(orgId, zoneId, branchId) && coll in ['inventoryAssets', 'inventoryMaintenanceJobs']
        && can(orgId, zoneId, branchId, 'inventory.assets.view');
    }
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryAssets/{id}/history/{h} {
      allow read: if inBranch(orgId, zoneId, branchId) && can(orgId, zoneId, branchId, 'inventory.assets.view');
    }
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryAssetAssignments/{id} {
      allow read: if inBranch(orgId, zoneId, branchId) && ((can(orgId, zoneId, branchId, 'inventory.assets.view')) || own());
    }

    // Reports and the dashboard (Inv-7): report viewers read the records in every report collection.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/{coll}/{id} {
      allow read: if inBranch(orgId, zoneId, branchId) && can(orgId, zoneId, branchId, 'inventory.reports.view')
        && coll in ['inventoryBalances', 'inventoryMovements', 'inventoryReceipts', 'inventoryIssues', 'inventoryReturns', 'inventoryAdjustments', 'inventoryUnavailableStock',
          'inventoryIssueRequests', 'inventoryPurchaseRequests', 'inventoryQuotations', 'inventoryPurchaseOrders', 'inventoryInvoices',
          'inventoryAssets', 'inventoryAssetAssignments', 'inventoryMaintenanceJobs'];
    }
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryVendors/{id} {
      allow read: if inBranch(orgId, zoneId, branchId) && can(orgId, zoneId, branchId, 'inventory.reports.view');
    }
    // The overview figures (`inventoryStats/overall`, kept by triggers): anyone whose role has a tile on the Inventory overview.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/inventoryStats/{id} {
      allow read: if inBranch(orgId, zoneId, branchId)
        && (can(orgId, zoneId, branchId, 'inventory.items.view') || can(orgId, zoneId, branchId, 'inventory.stock.view')
          || can(orgId, zoneId, branchId, 'inventory.reports.view') || can(orgId, zoneId, branchId, 'inventory.assets.view')
          || can(orgId, zoneId, branchId, 'inventory.purchaseRequest.approve') || can(orgId, zoneId, branchId, 'inventory.issue.approve')
          || can(orgId, zoneId, branchId, 'inventory.procure.operate'));
    }

    // Library masters (Lib-1): catalogue is branch-wide, readable by anyone who may browse it.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/{coll}/{id} {
      allow read: if staff(orgId, zoneId, branchId) && coll in ['libraries', 'libraryCategories', 'libraryCatalogue', 'libraryCopies', 'libraryStats'];
    }
    // Parents (Lib-8): browse the catalogue read-only; copies stay with staff.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/{coll}/{id} {
      allow read: if inBranch(orgId, zoneId, branchId) && coll in ['libraries', 'libraryCategories', 'libraryCatalogue']
        && request.auth.token.get('personType', '') == 'parent';
    }
    // Client writes without a callable (Lib-9): rules check who, the action stamp; fields and values are validated in the client (LibraryWrites). Each write stamps `lastWrite` (who, action, reason, server time);
    // the audit triggers in functions/src/library/audit.ts turn that stamp into an audit log entry.
    function stamped() {
      let mark = request.resource.data.lastWrite;
      return mark.by == request.auth.uid && mark.at == request.time && mark.action is string;
    }
    function libraryOf(orgId, zoneId, branchId, libraryId) {
      return get(/databases/$(db)/documents/orgs/$(orgId)/zones/$(zoneId)/branches/$(branchId)/libraries/$(libraryId)).data;
    }
    // Title keys: created before a title takes its identity, deleted when it changes. An existing key cannot be overwritten.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/uniqueKeys/{key} {
      allow get: if staff(orgId, zoneId, branchId) && key.matches('libraryTitle_.*');
      allow create: if staff(orgId, zoneId, branchId) && key.matches('libraryTitle_.*') && request.resource.data.keyType == 'libraryTitle';
      allow delete: if staff(orgId, zoneId, branchId) && key.matches('libraryTitle_.*');
    }
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/libraryCatalogue/{id} {
      allow create: if staff(orgId, zoneId, branchId) && stamped() && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.lastWrite.action == 'libraryCatalogue.create';
      allow update: if staff(orgId, zoneId, branchId) && stamped()
        && request.resource.data.lastWrite.action in ['libraryCatalogue.update', 'libraryCatalogue.status'];
    }
    // Copies: edit.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/libraryCopies/{barcode} {
      allow update: if staff(orgId, zoneId, branchId) && stamped()
        && request.resource.data.lastWrite.action in ['libraryCopy.update', 'libraryCopy.status']
        && (request.resource.data.lastWrite.action == 'libraryCopy.update'
          || request.resource.data.status in ['available', 'under_maintenance', 'damaged', 'lost', 'withdrawn']);
    }
    // Circulation moves a copy between shelf, loan, damaged and lost (LoanWrites); nothing else changes.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/libraryCopies/{barcode} {
      allow update: if staff(orgId, zoneId, branchId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'activeLoanId', 'updatedAt'])
        && request.resource.data.status in ['available', 'issued', 'damaged', 'lost', 'withdrawn'];
    }
    // The borrower record is created on first issue; circulation only touches what the desk shows and the counters.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/libraryMembers/{id} {
      allow create: if staff(orgId, zoneId, branchId) && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.blocked == false && request.resource.data.activeLoans in [0, 1];
      allow update: if staff(orgId, zoneId, branchId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'classId', 'section', 'admissionNumber', 'activeLoans', 'blocked', 'blockedBy', 'updatedAt']);
    }
    // Manual block / unblock of a member.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/libraryMembers/{id} {
      allow update: if staff(orgId, zoneId, branchId) && stamped()
        && request.resource.data.lastWrite.action == 'libraryMember.block';
    }
    // Borrowing policies: library and person type are fixed once created.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/libraryBorrowingPolicies/{id} {
      allow create: if staff(orgId, zoneId, branchId) && stamped() && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.lastWrite.action == 'libraryPolicy.create'
        && libraryOf(orgId, zoneId, branchId, request.resource.data.libraryId).status == 'active';
      allow update: if staff(orgId, zoneId, branchId) && stamped()
        && request.resource.data.lastWrite.action in ['libraryPolicy.update', 'libraryPolicy.status']
        && request.resource.data.libraryId == resource.data.libraryId
        && request.resource.data.memberType == resource.data.memberType;
    }
    // Book records (Lib-2): librarians, and report readers.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/libraryBooks/{id} {
      allow read: if staff(orgId, zoneId, branchId);
    }
    // Members and borrowing policies (Lib-3); report readers see them for the dashboard.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/{coll}/{id} {
      allow read: if staff(orgId, zoneId, branchId) && coll in ['libraryMembers', 'libraryBorrowingPolicies'];
    }
    // A parent reads their ward's membership (Lib-8).
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/libraryMembers/{id} {
      allow read: if inBranch(orgId, zoneId, branchId) && resource.data.personErpId in request.auth.token.get('wardStudentIds', []);
    }

    // Loans (Lib-4): staff, or the borrower / parent by ERP ID.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/libraryLoans/{id} {
      allow read: if inBranch(orgId, zoneId, branchId) && ((staff(orgId, zoneId, branchId)) || own());
      // Circulation (client transactions in LoanWrites): issue, then return / renew / mark lost of an active loan.
      allow create: if staff(orgId, zoneId, branchId) && stamped()
        && request.resource.data.lastWrite.action == 'libraryLoan.issue'
        && request.resource.data.issuedBy == request.auth.uid && request.resource.data.status == 'active';
      allow update: if staff(orgId, zoneId, branchId) && stamped() && resource.data.status == 'active'
        && request.resource.data.lastWrite.action in ['libraryLoan.return', 'libraryLoan.renew', 'libraryLoan.markLost'];
    }

    // Fines (Lib-6): staff, or the borrower / parent by ERP ID.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/libraryFines/{id} {
      // Raised by a return or a lost mark; only a dismissed lost-copy incident waives it (LoanWrites).
      allow update: if staff(orgId, zoneId, branchId) && stamped()
        && request.resource.data.lastWrite.action == 'libraryFine.waive'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['waived', 'outstanding', 'status', 'waivers', 'updatedAt', 'lastWrite']);
      allow create: if staff(orgId, zoneId, branchId)
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.status == 'outstanding';
      allow read: if inBranch(orgId, zoneId, branchId)
        && ((staff(orgId, zoneId, branchId)) || own());
    }

    // Incidents (Lib-6): staff, or the member / parent by ERP ID.
    match /orgs/{orgId}/zones/{zoneId}/branches/{branchId}/libraryIncidents/{id} {
      allow create: if staff(orgId, zoneId, branchId)
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.status == 'open';
      allow update: if staff(orgId, zoneId, branchId) && stamped() && resource.data.status == 'open'
        && request.resource.data.status == 'resolved' && request.resource.data.lastWrite.action == 'libraryIncident.resolve'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['status', 'resolution', 'resolutionRemarks', 'repairCost', 'charge', 'repairStatus', 'resolvedBy', 'resolvedAt', 'updatedAt', 'lastWrite']);
      allow read: if inBranch(orgId, zoneId, branchId)
        && ((staff(orgId, zoneId, branchId)) || own());
    }

    match /devices/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['mute']);

      match /tokens/{id} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['token', 'platform', 'app', 'updatedAt'])
          && request.resource.data.token is string;
      }
    }
  }
}
