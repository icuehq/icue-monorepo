rules_version = '2';

// Clients read; all writes go through Cloud Functions (Admin SDK bypasses rules).
// Exceptions: own device tokens/mute, Receive Stock (receipts, ledger rows, balances), issue request submit/approve, verification count lines (offline counting, Inv-8), the master collections, and purchase requests/quotations/invoices.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function inSchool(schoolId) { return signedIn() && string(request.auth.token.schoolId) == schoolId; }
    function access(schoolId) { return get(/databases/$(db)/documents/schools/$(schoolId)/userAccess/$(request.auth.uid)).data; }
    function can(schoolId, p) { return p in access(schoolId).permissions; }
    function onCampus(schoolId, c) { return access(schoolId).hasAllCampuses == true || c in access(schoolId).campusIds; }
    function own() {
      return resource.data.personErpId == request.auth.token.get('personErpId', null)
          || resource.data.personErpId in request.auth.token.get('wardStudentIds', []);
    }

    // Default: no client writes anywhere under a school. Reads need an explicit rule below.
    // auditLogs, requests, uniqueKeys and outbox have no client access at all.
    match /schools/{schoolId}/{coll}/{id} {
      allow write: if false;
    }

    match /schools/{schoolId}/userAccess/{uid} {
      allow read: if inSchool(schoolId) && request.auth.uid == uid;
    }
    match /schools/{schoolId}/config/{doc} {
      allow read: if inSchool(schoolId);
    }
    match /schools/{schoolId}/notifications/{id} {
      allow read: if inSchool(schoolId) && resource.data.uid == request.auth.uid;
    }

    // Inventory masters (Inv-1).
    match /schools/{schoolId}/{coll}/{id} {
      allow read: if inSchool(schoolId) && coll in ['inventoryCategories', 'inventoryUnits', 'inventoryItems']
        && (can(schoolId, 'inventory.items.view') || can(schoolId, 'inventory.issue.request') || can(schoolId, 'inventory.purchaseRequest.request'));
    }
    // Masters are plain client CRUD for the users who manage them (no field validation, no audit log).
    // Creates are keyed by the lowercased code, so an existing code cannot be recreated.
    match /schools/{schoolId}/inventoryCategories/{id} {
      allow write: if inSchool(schoolId) && can(schoolId, 'inventory.settings');
    }
    match /schools/{schoolId}/inventoryUnits/{id} {
      allow write: if inSchool(schoolId) && can(schoolId, 'inventory.settings');
    }
    match /schools/{schoolId}/inventoryStores/{id} {
      allow write: if inSchool(schoolId) && can(schoolId, 'inventory.settings');
    }
    match /schools/{schoolId}/inventoryItems/{id} {
      allow write: if inSchool(schoolId) && can(schoolId, 'inventory.items.manage');
    }
    match /schools/{schoolId}/inventoryVendors/{id} {
      allow write: if inSchool(schoolId) && can(schoolId, 'inventory.vendors.manage');
    }
    match /schools/{schoolId}/libraries/{id} {
      allow write: if inSchool(schoolId) && can(schoolId, 'library.settings');
    }
    match /schools/{schoolId}/libraryCategories/{id} {
      allow write: if inSchool(schoolId) && can(schoolId, 'library.catalogue');
    }

    // Purchase requests, quotations and invoices: client writes for the roles that handle them.
    match /schools/{schoolId}/inventoryPurchaseRequests/{id} {
      allow write: if inSchool(schoolId)
        && (can(schoolId, 'inventory.purchaseRequest.request') || can(schoolId, 'inventory.purchaseRequest.approve'));
      // Issuing, cancelling or closing a purchase order moves its quantity on the request.
      allow update: if inSchool(schoolId) && can(schoolId, 'inventory.procure.operate');
      // The last fully received order completes its request.
      allow update: if inSchool(schoolId) && can(schoolId, 'inventory.stock.operate')
        && request.resource.data.status == 'completed';
    }
    match /schools/{schoolId}/inventoryQuotations/{id} {
      allow write: if inSchool(schoolId) && can(schoolId, 'inventory.procure.operate');
    }
    match /schools/{schoolId}/inventoryInvoices/{id} {
      allow write: if inSchool(schoolId) && can(schoolId, 'inventory.procure.operate');
    }
    // Purchase orders: client writes until cancelled or closed; receiving stays a callable.
    match /schools/{schoolId}/inventoryPurchaseOrders/{id} {
      allow create: if inSchool(schoolId) && can(schoolId, 'inventory.procure.operate')
        && request.resource.data.status == 'draft';
      allow update: if inSchool(schoolId) && can(schoolId, 'inventory.procure.operate')
        && !(resource.data.status in ['cancelled', 'closed']);
      // Receiving goods moves an order to (partially / fully) received.
      allow update: if inSchool(schoolId) && can(schoolId, 'inventory.stock.operate')
        && onCampus(schoolId, resource.data.deliveryCampusId)
        && request.resource.data.status in ['partially_received', 'fully_received'];
    }
    match /schools/{schoolId}/inventoryPurchaseOrders/{id}/revisions/{rev} {
      allow create: if inSchool(schoolId) && can(schoolId, 'inventory.procure.operate');
    }
    // Sequence counters (PR/QT/PO numbers) are bumped by clients that hold any permission (parents hold none).
    match /schools/{schoolId}/counters/{id} {
      allow read, write: if inSchool(schoolId) && access(schoolId).permissions.size() > 0;
    }

    match /schools/{schoolId}/inventoryItems/{itemId}/variants/{id} {
      allow write: if inSchool(schoolId) && can(schoolId, 'inventory.items.manage');
      allow read: if inSchool(schoolId) && (can(schoolId, 'inventory.items.view') || can(schoolId, 'inventory.issue.request') || can(schoolId, 'inventory.purchaseRequest.request'));
    }
    // Stores are readable school-wide so a transfer can name a destination on another campus.
    match /schools/{schoolId}/inventoryStores/{id} {
      allow read: if inSchool(schoolId)
        && (can(schoolId, 'inventory.stock.view') || can(schoolId, 'inventory.settings') || can(schoolId, 'inventory.issue.request'));
    }

    // Stock (Inv-2): campus-scoped, written only by Functions.
    match /schools/{schoolId}/{coll}/{id} {
      allow read: if inSchool(schoolId)
        && coll in ['inventoryBalances', 'inventoryMovements', 'inventoryReceipts', 'inventoryIssues', 'inventoryReturns', 'inventoryAdjustments', 'inventoryUnavailableStock']
        && can(schoolId, 'inventory.stock.view') && onCampus(schoolId, resource.data.campusId);
    }
    // Receive Stock, issuing stock and returns are client transactions: stock operators on the campus create receipts, issues, returns, unavailable-stock
    // entries and ledger rows (never edit them) and create/update the store's balances.
    match /schools/{schoolId}/{coll}/{id} {
      allow create: if inSchool(schoolId) && coll in ['inventoryReceipts', 'inventoryIssues', 'inventoryReturns', 'inventoryAdjustments', 'inventoryUnavailableStock', 'inventoryMovements']
        && can(schoolId, 'inventory.stock.operate') && onCampus(schoolId, request.resource.data.campusId)
        && request.resource.data.createdBy == request.auth.uid;
    }
    // A return only moves an issue's returned quantities.
    match /schools/{schoolId}/inventoryIssues/{id} {
      allow update: if inSchool(schoolId) && can(schoolId, 'inventory.stock.operate')
        && onCampus(schoolId, resource.data.campusId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lineItems', 'updatedAt']);
    }
    // Acknowledging an issue only fills its empty acknowledgement.
    match /schools/{schoolId}/inventoryIssues/{id} {
      allow update: if inSchool(schoolId) && can(schoolId, 'inventory.stock.operate')
        && onCampus(schoolId, resource.data.campusId)
        && resource.data.acknowledgement == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledgement', 'updatedAt'])
        && request.resource.data.acknowledgement.performedBy == request.auth.uid;
    }
    match /schools/{schoolId}/inventoryBalances/{id} {
      allow create, update: if inSchool(schoolId) && can(schoolId, 'inventory.stock.operate')
        && onCampus(schoolId, request.resource.data.campusId);
    }
    // Submitting, approving/rejecting and issuing against an issue request, and acknowledging an issue, are client writes.
    match /schools/{schoolId}/inventoryIssueRequests/{id} {
      allow create: if inSchool(schoolId) && can(schoolId, 'inventory.issue.request')
        && onCampus(schoolId, request.resource.data.campusId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending';
      // Approve / reject: only while pending, by an approver on the campus, touching only the decision fields.
      allow update: if inSchool(schoolId) && can(schoolId, 'inventory.issue.approve')
        && onCampus(schoolId, resource.data.campusId)
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lineItems', 'approval', 'updatedAt'])
        && request.resource.data.approval.performedBy == request.auth.uid;
    }
    // Issuing stock only moves an approved request's issued quantities and status.
    match /schools/{schoolId}/inventoryIssueRequests/{id} {
      allow update: if inSchool(schoolId) && can(schoolId, 'inventory.stock.operate')
        && onCampus(schoolId, resource.data.campusId)
        && resource.data.status in ['approved', 'partially_issued']
        && request.resource.data.status in ['partially_issued', 'issued']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lineItems', 'updatedAt']);
    }
    // The requester may withdraw a pending request; a stock operator may close one still awaiting issue.
    match /schools/{schoolId}/inventoryIssueRequests/{id} {
      allow update: if inSchool(schoolId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closure', 'updatedAt'])
        && request.resource.data.closure.performedBy == request.auth.uid
        && ((resource.data.createdBy == request.auth.uid && resource.data.status == 'pending' && request.resource.data.status == 'cancelled')
          || (can(schoolId, 'inventory.stock.operate') && onCampus(schoolId, resource.data.campusId)
            && resource.data.status in ['approved', 'partially_issued'] && request.resource.data.status == 'closed'));
    }
    // Requesters see their own requests; approvers and stock users see the campus's.
    match /schools/{schoolId}/inventoryIssueRequests/{id} {
      allow read: if inSchool(schoolId) && (resource.data.createdBy == request.auth.uid
        || ((can(schoolId, 'inventory.stock.view') || can(schoolId, 'inventory.issue.approve')) && onCampus(schoolId, resource.data.campusId)));
    }
    // Requesting, approving, cancelling, dispatching and receiving a transfer are client writes.
    match /schools/{schoolId}/inventoryTransfers/{id} {
      allow create: if inSchool(schoolId) && can(schoolId, 'inventory.stock.operate')
        && onCampus(schoolId, request.resource.data.campusId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'requested';
    }
    // Approving a transfer moves a requested one to approved, by an approver on the source campus.
    match /schools/{schoolId}/inventoryTransfers/{id} {
      allow update: if inSchool(schoolId) && can(schoolId, 'inventory.adjustment.approve')
        && onCampus(schoolId, resource.data.campusId)
        && resource.data.status == 'requested'
        && request.resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approval', 'updatedAt'])
        && request.resource.data.approval.performedBy == request.auth.uid;
    }
    // A requested or approved transfer can be withdrawn by a stock operator on the source campus, with a reason.
    match /schools/{schoolId}/inventoryTransfers/{id} {
      allow update: if inSchool(schoolId) && can(schoolId, 'inventory.stock.operate')
        && onCampus(schoolId, resource.data.campusId)
        && resource.data.status in ['requested', 'approved']
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelReason', 'cancelledBy', 'updatedAt'])
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.cancelReason.size() > 0;
    }
    // Dispatching sends an approved transfer out, by a stock operator on the source campus.
    match /schools/{schoolId}/inventoryTransfers/{id} {
      allow update: if inSchool(schoolId) && can(schoolId, 'inventory.stock.operate')
        && onCampus(schoolId, resource.data.campusId)
        && resource.data.status == 'approved'
        && request.resource.data.status == 'dispatched'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lineItems', 'status', 'dispatch', 'updatedAt'])
        && request.resource.data.dispatch.performedBy == request.auth.uid;
    }
    // Receiving records what arrived, by a stock operator on the destination campus.
    match /schools/{schoolId}/inventoryTransfers/{id} {
      allow update: if inSchool(schoolId) && can(schoolId, 'inventory.stock.operate')
        && onCampus(schoolId, resource.data.toCampusId)
        && resource.data.status in ['dispatched', 'partially_received']
        && request.resource.data.status in ['partially_received', 'received']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lineItems', 'status', 'receipt', 'receipts', 'updatedAt'])
        && request.resource.data.receipt.performedBy == request.auth.uid;
    }
    // A transfer shortfall is registered against the source store by the receiving campus.
    match /schools/{schoolId}/inventoryUnavailableStock/{id} {
      allow create: if inSchool(schoolId) && can(schoolId, 'inventory.stock.operate')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.referenceType == 'transfer'
        && request.resource.data.status == 'resolved'
        && onCampus(schoolId, get(/databases/$(db)/documents/schools/$(schoolId)/inventoryTransfers/$(request.resource.data.referenceId)).data.toCampusId);
    }
    // Resolving an unavailable-stock entry: restore, repair or write off, by a stock operator on its campus.
    match /schools/{schoolId}/inventoryUnavailableStock/{id} {
      allow update: if inSchool(schoolId) && can(schoolId, 'inventory.stock.operate')
        && onCampus(schoolId, resource.data.campusId)
        && resource.data.status in ['open', 'in_repair']
        && request.resource.data.status in ['in_repair', 'resolved']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolution', 'resolutionNote', 'resolvedAt', 'resolvedBy', 'updatedAt']);
    }
    // Either end of a transfer may read it.
    match /schools/{schoolId}/inventoryTransfers/{id} {
      allow read: if inSchool(schoolId) && can(schoolId, 'inventory.stock.view')
        && (onCampus(schoolId, resource.data.campusId) || onCampus(schoolId, resource.data.toCampusId));
    }

    // Procurement (Inv-3). Vendors are school-wide; requesters see their own requests,
    // approvers and procurement the campus's.
    match /schools/{schoolId}/inventoryVendors/{id} {
      allow read: if inSchool(schoolId) && (can(schoolId, 'inventory.vendors.manage') || can(schoolId, 'inventory.procure.operate'));
    }
    match /schools/{schoolId}/inventoryPurchaseRequests/{id} {
      allow read: if inSchool(schoolId) && (resource.data.createdBy == request.auth.uid
        || ((can(schoolId, 'inventory.purchaseRequest.approve') || can(schoolId, 'inventory.procure.operate')) && onCampus(schoolId, resource.data.campusId)));
    }

    // Quotations and purchase orders (Inv-4): procurement on the campus.
    match /schools/{schoolId}/inventoryQuotations/{id} {
      allow read: if inSchool(schoolId) && can(schoolId, 'inventory.procure.operate') && onCampus(schoolId, resource.data.campusId);
    }
    // Receiving staff read orders due at their campus; invoices (Inv-5) follow procurement.
    match /schools/{schoolId}/inventoryPurchaseOrders/{id} {
      allow read: if inSchool(schoolId) && ((can(schoolId, 'inventory.procure.operate')
        && (onCampus(schoolId, resource.data.campusId) || onCampus(schoolId, resource.data.deliveryCampusId)))
        || (can(schoolId, 'inventory.stock.operate') && onCampus(schoolId, resource.data.deliveryCampusId)));
    }
    match /schools/{schoolId}/inventoryInvoices/{id} {
      allow read: if inSchool(schoolId) && can(schoolId, 'inventory.procure.operate') && onCampus(schoolId, resource.data.campusId);
    }
    match /schools/{schoolId}/inventoryPurchaseOrders/{id}/revisions/{rev} {
      allow read: if inSchool(schoolId) && can(schoolId, 'inventory.procure.operate');
    }

    // Assets and maintenance (Inv-6). Assignees also read their own custody records.
    match /schools/{schoolId}/{coll}/{id} {
      allow read: if inSchool(schoolId) && coll in ['inventoryAssets', 'inventoryMaintenanceJobs']
        && can(schoolId, 'inventory.assets.view') && onCampus(schoolId, resource.data.campusId);
    }
    match /schools/{schoolId}/inventoryAssets/{id}/history/{h} {
      allow read: if inSchool(schoolId) && can(schoolId, 'inventory.assets.view') && onCampus(schoolId, resource.data.campusId);
    }
    match /schools/{schoolId}/inventoryAssetAssignments/{id} {
      allow read: if inSchool(schoolId) && ((can(schoolId, 'inventory.assets.view') && onCampus(schoolId, resource.data.campusId)) || own());
    }

    // Verification sessions (Inv-7): stock users on the campus; counting is also a direct line update so it queues offline.
    match /schools/{schoolId}/inventoryVerifications/{id} {
      allow read: if inSchool(schoolId) && can(schoolId, 'inventory.stock.view') && onCampus(schoolId, resource.data.campusId);
    }
    match /schools/{schoolId}/inventoryVerifications/{id}/lineItems/{l} {
      allow read: if inSchool(schoolId) && can(schoolId, 'inventory.stock.view') && onCampus(schoolId, resource.data.campusId);
      // Count only: the same fields `inventory-verification-count` writes, while the session is still `counting`.
      allow update: if inSchool(schoolId) && can(schoolId, 'inventory.stock.operate') && onCampus(schoolId, resource.data.campusId)
        && get(/databases/$(db)/documents/schools/$(schoolId)/inventoryVerifications/$(id)).data.status == 'counting'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counted', 'difference', 'reason', 'note', 'countedBy', 'countedAt'])
        && request.resource.data.counted is number && request.resource.data.counted >= 0
        && request.resource.data['difference'] == request.resource.data.counted - resource.data.expected
        && request.resource.data.countedBy == request.auth.uid
        && (request.resource.data.reason == null
            || request.resource.data.reason in ['count_correction', 'missing', 'excess', 'other']);
    }

    // Reports and the dashboard (Inv-7): report viewers read the campus's records in every report collection.
    match /schools/{schoolId}/{coll}/{id} {
      allow read: if inSchool(schoolId) && can(schoolId, 'inventory.reports.view') && onCampus(schoolId, resource.data.campusId)
        && coll in ['inventoryBalances', 'inventoryMovements', 'inventoryReceipts', 'inventoryIssues', 'inventoryReturns', 'inventoryAdjustments', 'inventoryUnavailableStock',
          'inventoryIssueRequests', 'inventoryTransfers', 'inventoryPurchaseRequests', 'inventoryQuotations', 'inventoryPurchaseOrders', 'inventoryInvoices',
          'inventoryAssets', 'inventoryAssetAssignments', 'inventoryMaintenanceJobs', 'inventoryVerifications'];
    }
    match /schools/{schoolId}/inventoryVendors/{id} {
      allow read: if inSchool(schoolId) && can(schoolId, 'inventory.reports.view');
    }

    // Library masters (Lib-1): catalogue is school-wide, readable by anyone who may browse it.
    match /schools/{schoolId}/{coll}/{id} {
      allow read: if inSchool(schoolId) && coll in ['libraries', 'libraryCategories', 'libraryCatalogue', 'libraryCopies']
        && can(schoolId, 'library.catalogue');
    }
    // Parents (Lib-8): browse the catalogue read-only; copies stay with staff.
    match /schools/{schoolId}/{coll}/{id} {
      allow read: if inSchool(schoolId) && coll in ['libraries', 'libraryCategories', 'libraryCatalogue']
        && request.auth.token.get('personType', '') == 'parent';
    }
    // Acquisition records (Lib-2): librarians, and report readers on the campus.
    match /schools/{schoolId}/libraryAcquisitions/{id} {
      allow read: if inSchool(schoolId) && (can(schoolId, 'library.catalogue')
        || (can(schoolId, 'library.reports.view') && onCampus(schoolId, resource.data.campusId)));
    }
    // Members and borrowing policies (Lib-3); report readers see them for the dashboard.
    match /schools/{schoolId}/{coll}/{id} {
      allow read: if inSchool(schoolId) && coll in ['libraryMembers', 'libraryBorrowingPolicies']
        && (can(schoolId, 'library.members.view') || can(schoolId, 'library.reports.view'));
    }
    // A parent reads their ward's membership (Lib-8).
    match /schools/{schoolId}/libraryMembers/{id} {
      allow read: if inSchool(schoolId) && resource.data.personErpId in request.auth.token.get('wardStudentIds', []);
    }

    // Loans (Lib-4): circulation staff on the campus, or the borrower / parent by ERP ID.
    match /schools/{schoolId}/libraryLoans/{id} {
      allow read: if inSchool(schoolId) && (((can(schoolId, 'library.circulation.operate') || can(schoolId, 'library.reports.view')) && onCampus(schoolId, resource.data.campusId)) || own());
    }

    // Reservations (Lib-5): same readers as loans.
    match /schools/{schoolId}/libraryReservations/{id} {
      allow read: if inSchool(schoolId) && (((can(schoolId, 'library.circulation.operate') || can(schoolId, 'library.reports.view')) && onCampus(schoolId, resource.data.campusId)) || own());
    }

    // Fines (Lib-6): circulation staff or fine waivers on the campus, or the borrower / parent by ERP ID.
    match /schools/{schoolId}/libraryFines/{id} {
      allow read: if inSchool(schoolId)
        && (((can(schoolId, 'library.circulation.operate') || can(schoolId, 'library.fines.waive') || can(schoolId, 'library.reports.view')) && onCampus(schoolId, resource.data.campusId)) || own());
    }

    // Incidents (Lib-6): circulation staff on the campus, or the member / parent by ERP ID.
    match /schools/{schoolId}/libraryIncidents/{id} {
      allow read: if inSchool(schoolId)
        && (((can(schoolId, 'library.circulation.operate') || can(schoolId, 'library.reports.view')) && onCampus(schoolId, resource.data.campusId)) || own());
    }

    // Transfers (Lib-7): librarians at the source or the destination campus.
    match /schools/{schoolId}/libraryTransfers/{id} {
      allow read: if inSchool(schoolId) && (can(schoolId, 'library.catalogue') || can(schoolId, 'library.reports.view'))
        && (onCampus(schoolId, resource.data.campusId) || onCampus(schoolId, resource.data.toCampusId));
    }

    // Stock verification sessions (Lib-7): librarians on the campus.
    match /schools/{schoolId}/libraryVerifications/{id} {
      allow read: if inSchool(schoolId) && (can(schoolId, 'library.catalogue') || can(schoolId, 'library.reports.view'))
        && onCampus(schoolId, resource.data.campusId);
    }

    match /devices/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['mute']);

      match /tokens/{id} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['token', 'platform', 'app', 'updatedAt'])
          && request.resource.data.token is string;
      }
    }
  }
}
